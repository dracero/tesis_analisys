{
  "name": "tesis-analisys",
  "version": "1.0.0",
  "description": "Analista de Tesis Full-Stack con LangGraph, Crawl4AI, Búsqueda Académica y Gemini",
  "scripts": {
    "dev:backend": "uv run uvicorn server:app --host 0.0.0.0 --port 8000 --reload",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"uv run uvicorn server:app --host 0.0.0.0 --port 8000 --reload\" \"npm --prefix frontend run dev\"",
    "build": "npm --prefix frontend run build",
    "start": "uv run uvicorn server:app --host 0.0.0.0 --port 8000",
    "harness:capture": "uv run python scripts/harness2_offline.py capture",
    "harness:offline": "uv run python scripts/harness2_offline.py optimize",
    "harness:optimize": "uv run python scripts/optimize_harness.py",
    "harness:rollback": "uv run python scripts/optimize_harness.py --rollback",
    "harness:verify-ref": "uv run python harness/scripts/verify_single_ref.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

